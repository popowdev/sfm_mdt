{
  "manifest_version": 1,
  "type": "WebApp",
  "meta": {
    "name": "RP MDT Dispatch",
    "author": "RP MDT",
    "version": "1.0.0",
    "minimum-overwolf-version": "0.160.0",
    "description": "Overlay dispatch MDT pour FiveM (GTA V). Affiche exemple.tld in-game via une hotkey.",
    "dock_button_title": "RP MDT Dispatch",
    "icon": "icons/IconMouseOver.png",
    "icon_gray": "icons/IconMouseNormal.png",
    "launcher_icon": "icons/desktop-icon.ico",
    "window_icon": "icons/IconMouseOver.png"
  },
  "permissions": [
    "Hotkeys",
    "GameInfo"
  ],
  "data": {
    "start_window": "background",
    "hotkeys": {
      "mdt_dispatch_showhide": {
        "title": "Afficher / masquer le dispatch MDT",
        "action-type": "toggle",
        "default": "F8"
      }
    },
    "externally_connectable": {
      "matches": [
        "http://*.overwolf.com",
        "https://*.overwolf.com",
        "https://*.exemple.tld",
        "http://*.exemple.tld"
      ]
    },
    "force_browser": "user",
    "windows": {
      "background": {
        "file": "windows/background/background.html",
        "background_optimization": true,
        "is_background_page": true
      },
      "desktop": {
        "file": "windows/desktop/desktop.html",
        "desktop_only": true,
        "native_window": true,
        "resizable": true,
        "transparent": false,
        "override_on_update": true,
        "size": {
          "width": 1280,
          "height": 800
        },
        "min_size": {
          "width": 1000,
          "height": 600
        }
      },
      "in_game": {
        "file": "windows/in_game/in_game.html",
        "in_game_only": true,
        "focus_game_takeover": "ReleaseOnHidden",
        "focus_game_takeover_release_hotkey": "mdt_dispatch_showhide",
        "resizable": true,
        "transparent": true,
        "override_on_update": true,
        "size": {
          "width": 1280,
          "height": 800
        },
        "min_size": {
          "width": 900,
          "height": 600
        }
      }
    },
    "game_targeting": {
      "type": "dedicated",
      "game_ids": [8032]
    },
    "game_events": [8032],
    "launch_events": [
      {
        "event": "GameLaunch",
        "event_data": {
          "game_ids": [8032]
        },
        "start_minimized": true
      }
    ]
  }
}
